{
  "date": "2026-10-23",
  "device": "Apple M1",
  "outcome": "Fixed repeated app windows caused by automated verification/benchmark launches. Both modes now render offscreen by default.",
  "cause": "Each old --verify/--benchmark process created and activated a preview NSWindow, then terminated after its finite test run. Repeated test cases repeatedly showed and closed the preview.",
  "implementation": {
    "automaticModes": [
      "--verify",
      "--benchmark"
    ],
    "ui": "Prohibited application activation policy, no menu/window creation or app activation for automated modes. Error paths report to stderr and exit rather than showing alerts.",
    "rendering": "A retained private BGRA8 render target replaces drawable acquisition/presentation only for automated runs. A timer drives the same Metal frame passes at the configured cap.",
    "lifetime": "The single-frame semaphore is released after main-thread completion counters and verification consume the completed frame, preventing a timer from submitting another frame in that interval.",
    "normalPreview": "Ordinary launches still create the existing resizable window and use Metal drawable presentation, visibility/sleep pause logic and existing menu controls.",
    "explicitVisualOverride": "--windowed-test is an explicit developer opt-in for one visible automated run. It is not used by any automated test driver.",
    "regressionGuards": "All active Python GPU verification/benchmark drivers assert offscreen=true, windowCount=0 and activationPolicy=2. verify_headless.py is part of macos/test.sh."
  },
