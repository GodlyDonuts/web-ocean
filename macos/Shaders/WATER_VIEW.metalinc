// Shared scattering color for the surface and the water volume behind it.
metal::float3 waterVolumeRadiance(float night, float rayY, float depth) {
    float up=metal::smoothstep(-0.7,0.5,rayY);
    metal::float3 light=metal::mix(metal::float3(0.012,0.065,0.085),
        metal::float3(0.0020,0.0060,0.0100),night);
    return light*(0.65+0.35*up)*metal::exp(-0.055*metal::max(depth,0.0));
}
