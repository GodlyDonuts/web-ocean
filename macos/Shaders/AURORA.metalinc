// Night-sky events shared by the full-resolution sky resolve and the
// reflection cube: aurora curtains and meteors. Inputs are plain vectors so
// shaders with different Frame layouts can include this file.
// fx = (aurora strength, wrapped seconds, meteor rate, bioluminescence).
inline float fxHash(float2 p) { return metal::fract(metal::sin(metal::dot(p, float2(127.1, 311.7))) * 43758.5453); }
inline float fxNoise(float2 p) {
    float2 i = metal::floor(p), f = metal::fract(p);
    float2 u = f * f * (3.0 - 2.0 * f);
    return metal::mix(metal::mix(fxHash(i), fxHash(i + float2(1, 0)), u.x),
                      metal::mix(fxHash(i + float2(0, 1)), fxHash(i + float2(1, 1)), u.x), u.y);
}
// Interleaved gradient noise for per-pixel march jitter.
inline float fxIgn(float2 p) { return metal::fract(52.9829189 * metal::fract(metal::dot(p, float2(0.06711056, 0.00583715)))); }

// Seamless noise around the horizon: sample a circle of radius r.
inline float fxRing(float az, float r, float2 offset) {
    return fxNoise(float2(metal::cos(az), metal::sin(az)) * r + offset);
}

// Aurora arcs drawn analytically in sky angles: each arc has a wavy, sharp
// lower border, field-aligned vertical rays and a green-to-red altitude
// gradient. No ray march, so it is noise-free and costs a few noise taps.
// `steps` and `jitter` are kept for call-site compatibility.
inline float3 auroraRadiance(float3 dir, float4 fx, float night, int steps, float jitter) {
    float strength = fx.x * night;
    if (strength < 0.002 || dir.y < 0.002) return float3(0.0);
    float t = fx.y;
    float az = metal::atan2(dir.x, dir.z);
    float el = metal::asin(metal::clamp(dir.y, 0.0, 1.0));
    float3 sum = float3(0.0);
    for (int k = 0; k < 4; ++k) {
        float fk = float(k);
        float seed = fxHash(float2(fk, 17.0));
        float e0 = 0.05 + 0.11 * fk + 0.05 * seed;
        float base = e0 + (0.035 + 0.03 * fk) * (fxRing(az, 1.6, float2(fk * 7.1, t * 0.004)) - 0.5) * 2.0
                   + 0.012 * metal::sin(az * 5.0 + t * (0.02 + 0.01 * seed) + seed * 6.0)
                   + 0.006 * (fxRing(az, 9.0, float2(t * 0.012, fk * 3.3)) - 0.5);
        float above = el - base;
        if (above < -0.012) continue;
        float height = (0.035 + 0.4 * e0) * (0.7 + 0.6 * seed);
        float lower = metal::smoothstep(-0.007, 0.003, above);
        float a = metal::max(above, 0.0);
        float green = metal::exp(-a / height) * lower;
        float red = metal::smoothstep(0.3, 1.4, a / height) * metal::exp(-a / (height * 2.2));
        float rays = 0.15 + 0.85 * fxRing(az, 38.0 + 9.0 * seed, float2(t * 0.035, fk * 11.0));
        rays *= rays;
        rays *= 0.55 + 0.45 * fxRing(az, 120.0, float2(fk * 5.0, -t * 0.08));
        float extent = metal::smoothstep(0.42, 0.78, fxRing(az, 1.4, float2(fk * 13.0 + t * 0.002, 2.0)));
        float pulse = 0.3 + 0.7 * metal::smoothstep(0.15, 0.85, fxNoise(float2(fk * 3.3 + seed, t * 0.01)));
        float3 g = float3(0.10, 1.00, 0.42), r = float3(1.0, 0.13, 0.42) * (0.6 + 0.6 * seed);
        float edgeGlow = metal::exp(-a * a / (0.0002 + 0.0006 * seed)) * lower;  // bright crisp base
        sum += (g * (green + 0.6 * edgeGlow) + r * red * 0.8) * rays * extent * pulse;
    }
    float horizon = metal::smoothstep(0.002, 0.03, dir.y);
    return sum * strength * horizon * 0.085;
}

// Up to six meteors in flight, each on a short randomized schedule.
inline float3 meteorRadiance(float3 dir, float4 fx, float night, float pixAng, float3 fwd) {
    float rate = fx.z * night;
    if (rate < 0.01 || dir.y < 0.02) return float3(0.0);
    float3 sum = float3(0.0);
    for (int k = 0; k < 6; ++k) {
        float period = 9.0 + 4.0 * float(k);
        float local = fx.y + float(k) * 3.7;
        float n = metal::floor(local / period);
        float2 seed = float2(n, float(k) * 13.1);
        if (fxHash(seed) > metal::min(1.0, 0.18 * rate)) continue;
        float life = 0.45 + 0.9 * fxHash(seed + 1.0);
        float start = fxHash(seed + 2.0) * (period - life);
        float p = (local - n * period - start) / life;
        if (p < 0.0 || p > 1.0) continue;
        // Keep showers inside the fixed camera's sky rather than behind it.
        float az = metal::atan2(fwd.z, fwd.x) + (fxHash(seed + 3.0) - 0.5) * 1.3, el = 0.07 + 0.38 * fxHash(seed + 4.0);
        float3 c = float3(metal::cos(az) * metal::cos(el), metal::sin(el), metal::sin(az) * metal::cos(el));
        float3 r = metal::normalize(metal::cross(c, float3(0, 1, 0)));
        float3 u = metal::cross(r, c);
        float2 uv = float2(metal::dot(dir, r), metal::dot(dir, u));
        if (metal::dot(dir, c) < 0.9) continue;
        float ang = fxHash(seed + 5.0) * 6.2831853;
        float2 heading = float2(metal::cos(ang), -metal::abs(metal::sin(ang)) - 0.35);
        heading = metal::normalize(heading);
        float span = 0.12 + 0.18 * fxHash(seed + 6.0);
        float2 a = -heading * span * 0.5;
        float2 head = a + heading * span * p;
        float tail = span * (0.25 + 0.35 * metal::smoothstep(0.0, 0.4, p));
        float2 b = head - heading * tail;
        float2 pa = uv - b, ba = head - b;
        float x = metal::clamp(metal::dot(pa, ba) / metal::max(metal::dot(ba, ba), 1e-8), 0.0, 1.0);
        float dist = metal::length(pa - ba * x);
        float width = pixAng * 0.9 + 0.0004;
        float core = metal::exp(-dist * dist / (width * width));
        float glow = metal::exp(-dist * dist / (16.0 * width * width)) * 0.18;
        float envelope = metal::sin(3.14159265 * p);
        envelope *= envelope;
        float flare = 1.0 + 3.0 * metal::smoothstep(0.82, 0.95, p) * (1.0 - metal::smoothstep(0.95, 1.0, p));
        float3 tint = metal::mix(float3(1.0, 0.75, 0.45), float3(0.55, 1.0, 0.75), fxHash(seed + 7.0));
        float headGlow = metal::exp(-metal::dot(uv - head, uv - head) / (9.0 * width * width));
        sum += (metal::mix(tint, float3(1.0), x) * (core + glow) * x * x + float3(1.0, 0.95, 0.85) * headGlow * 2.0)
             * envelope * flare;
    }
    return sum * night * 0.6;
}

// 22-degree ice halo and parhelia (sun dogs) in thin cirrus veil. Returns a
// relative gain on the local sky radiance, so it scales with day or moonlight.
inline float3 iceHalo(float3 ray, float3 light, float veil) {
    float strength = metal::smoothstep(0.05, 0.4, veil) * (1.0 - metal::smoothstep(0.75, 1.0, veil));
    if (strength < 0.001 || light.y < -0.02) return float3(0.0);
    float ang = metal::acos(metal::clamp(metal::dot(ray, light), -1.0, 1.0));
    if (ang < 0.30 || ang > 0.62) return float3(0.0);
    float3 ring = float3(0.3835, 0.3875, 0.3935);
    float3 d = (float3(ang) - ring) / float3(0.0055, 0.0065, 0.009);
    float3 halo = metal::exp(-d * d) * float3(0.85, 0.75, 0.6);
    // Outer diffuse skirt: brighter just outside the ring than inside it.
    halo += float3(0.18) * metal::smoothstep(0.38, 0.4, ang) * metal::exp(-(ang - 0.39) * 9.0);
    // Sun dogs: bright prismatic spots at the light's altitude, slightly outside
    // the ring as the sun climbs.
    float elev = metal::asin(metal::clamp(light.y, -1.0, 1.0));
    float dogR = 0.3835 / metal::max(metal::cos(elev), 0.4);
    float3 h = metal::normalize(float3(ray.x, 0.0, ray.z) + float3(1e-5, 0.0, 0.0));
    float3 lh = metal::normalize(float3(light.x, 0.0, light.z) + float3(1e-5, 0.0, 0.0));
    float daz = metal::acos(metal::clamp(metal::dot(h, lh), -1.0, 1.0)) * metal::cos(elev);
    float rise = metal::asin(metal::clamp(ray.y, -1.0, 1.0)) - elev;
    float3 dd = (float3(daz) - float3(dogR, dogR + 0.006, dogR + 0.015)) / float3(0.012, 0.016, 0.03);
    float3 dog = metal::exp(-dd * dd) * metal::exp(-rise * rise / 0.0006) * float3(2.4, 2.0, 1.5);
    // Faint parhelic tails stretch away from the sun along its altitude.
    dog += float3(0.25) * metal::smoothstep(dogR, dogR + 0.02, daz) * metal::exp(-(daz - dogR) * 6.0)
        * metal::exp(-rise * rise / 0.00015);
    return (halo + dog) * strength * 0.55;
}

// Primary and secondary rainbows around the antisolar point while rain falls in
// sunlight, with Alexander's dark band between them. Relative gain on the sky.
inline float3 rainbowSpectrum(float t) {
    float3 c = float3(t - 0.86, t - 0.55, t - 0.22) / float3(0.2, 0.2, 0.18);
    return metal::exp(-c * c) * float3(1.0, 0.85, 0.95);
}
inline float3 rainbow(float3 ray, float3 sun, float strength) {
    if (strength < 0.001 || sun.y < -0.01 || sun.y > 0.67) return float3(0.0);
    float ang = metal::acos(metal::clamp(-metal::dot(ray, sun), -1.0, 1.0));
    if (ang < 0.55 || ang > 0.98) return float3(0.0);
    float primary = (ang - 0.7069) / (0.7365 - 0.7069);
    float secondary = (0.9338 - ang) / (0.9338 - 0.8797);
    float3 bow = rainbowSpectrum(primary) * 0.9 + rainbowSpectrum(secondary) * 0.38;
    // Light scattered inside the primary bow brightens the sky there.
    bow += float3(0.16) * (1.0 - metal::smoothstep(0.6, 0.71, ang)) * metal::smoothstep(0.55, 0.62, ang);
    float alexander = metal::smoothstep(0.73, 0.75, ang) * (1.0 - metal::smoothstep(0.86, 0.88, ang));
    return bow * strength - float3(0.12 * strength) * alexander;
}
